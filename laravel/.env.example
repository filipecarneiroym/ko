APP_NAME="K.O"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# No ar: APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning e SESSION_SECURE_COOKIE=true

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# Uma semana: o jogador não precisa digitar o apelido de novo (o cookie "lembrar" dura mais ainda).
SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file

# Relay da luta (php artisan ko:relay). No PC: ws://localhost:6001
# No ar, atrás do Nginx com HTTPS: KO_RELAY_URL=wss://seudominio.com/ws
# Vazio: usa o host do site (:6001 em HTTP; /ws em HTTPS).
KO_RELAY_URL=
KO_RELAY_PORTA=6001
# 127.0.0.1 = só o servidor acessa (o certo no ar). Para jogar com celulares na Wi-Fi de casa sem Nginx: 0.0.0.0
KO_RELAY_HOST=127.0.0.1

# Senha compartilhada para desbloquear a arena (maiúsculas e ponto exatos).
KO_SENHA_AMIGOS=ko
